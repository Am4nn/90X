# Hugging Face: huggingface.co/settings/tokens (read token). Faster downloads, no rate-limit warnings.
HF_TOKEN=

# AI via any OpenAI-compatible endpoint (DeepSeek, OpenAI, Anthropic's compat endpoint, OpenRouter, Ollama).
# Same key and models as web/.env.local. Card generation uses AI_MODEL_FAST.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_FAST=deepseek-flash
AI_MODEL_SMART=deepseek-v4-pro

# Supabase Postgres, session connection (port 5432). Used to load data. Same as DIRECT_URL in web/.env.local.
DATABASE_URL=

# Upstash Vector: same values as web/.env.local. The pipeline upserts knowledge chunks here.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
